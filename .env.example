# Copy of .env's shape. .env is tracked (the server builds `main` with its VITE_ values), so it holds
# ONLY publishable values. src/app/secrets.test.ts fails the test suite if any tracked file holds a secret.

# Publishable Supabase values for the owner's Supabase project (safe in the browser; row-level security
# is the boundary).
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_PROJECT_ID=<project-id>
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>
SUPABASE_PROJECT_ID=<project-id>

# Public origin for canonical / og:url / og:image, the sitemap and the approval email link.
VITE_SITE_URL=https://thewomenscollective.club

# "true" shows "Continue with Google" on /auth. Turn it on only once the Google provider is enabled in
# Supabase (Authentication → Providers) with <site>/auth in the redirect allow-list. Anything else hides it.
VITE_GOOGLE_AUTH=false

# Approval welcome email (server only, src/features/admin/approval-email.server.ts), via the Cloudflare
# Email Sending API. Set them in the server's .dev.vars, not here; blank means "email not set up" and
# /admin says so after each approval. EMAIL_FROM defaults to info@thewomenscollective.club.
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
EMAIL_FROM=

# Secrets NEVER go here. Server secrets go in .dev.vars (gitignored; the build copies it next to the
# built Worker, where `wrangler dev` reads it); DATABASE_URL only in your shell when applying migrations:
#   CF_EMAIL_API_TOKEN, SUPABASE_SERVICE_ROLE_KEY, DATABASE_URL, any sb_secret_… key
