# .env is tracked (the server builds `main` with it), so it holds ONLY public VITE_ values, baked into the
# browser bundle at build time. src/app/secrets.test.ts fails the test suite if a tracked file holds a secret.

# Public origin for canonical / og:url / og:image and the sitemap (no path).
VITE_SITE_URL=https://thewomenscollective.club
# "true" shows "Continue with Google" on /auth. Turn it on only with GOOGLE_CLIENT_ID/SECRET set on the server.
VITE_GOOGLE_AUTH=false
# "true" loads the doop design-sync script on /f/<slug> and allows its origin in the CSP. Design builds only: never production.
VITE_DOOP_SYNC=false

# ---------- Server environment: NOT in .env ----------
# On the server (and locally) these go in .env.local (gitignored; `bun run start` and `bun run dev` read it)
# or the service's environment. Never in a tracked file.
#
# APP_URL=https://thewomenscollective.club   # origin for links in emails and Better Auth's trusted origin
# DATA_DIR=./data                            # holds twc.db and uploads/
# BETTER_AUTH_SECRET=                        # secret, ≥ 32 chars, required: `openssl rand -base64 32`
# CF_EMAIL_ACCOUNT_ID=                       # Cloudflare Email Sending; blank = emails aren't sent
# CF_EMAIL_API_TOKEN=                        # secret
# EMAIL_FROM=info@thewomenscollective.club   # sender; this is the default
# BEEHIIV_API_KEY=                           # secret; with the id below, consented opt-ins reach Beehiiv. Blank = none sent
# BEEHIIV_PUBLICATION_ID=                    # the publication the key belongs to
# GOOGLE_CLIENT_ID=                          # both set = Google sign-in on
# GOOGLE_CLIENT_SECRET=                      # secret
# HOST=127.0.0.1                             # where `bun run start` listens (default 127.0.0.1:8788)
# PORT=8788
# NODE_ENV=production                        # on the server: emails without Cloudflare are skipped, not logged
