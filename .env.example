# Copy of .env's shape. .env is tracked (Lovable reads its values), so it holds ONLY publishable values.
# src/app/secrets.test.ts fails the test suite if any tracked file contains a server secret.

# Publishable Supabase values (safe in the browser; row-level security is the boundary).
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_PROJECT_ID=<project-id>
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>
SUPABASE_PROJECT_ID=<project-id>

# Optional: public origin for canonical / og:url / og:image (see README "Environment").
# VITE_SITE_URL=https://example.com

# Server secrets NEVER go here. Put them in .dev.vars (gitignored) locally and in Wrangler secrets
# (`wrangler secret put NAME`) for deploys:
#   SUPABASE_SERVICE_ROLE_KEY, LOVABLE_CRON_SECRET, any sb_secret_… key
